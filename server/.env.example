# SQLite file. On Railway, point this at the mounted volume, e.g. sqlite:////data/zoom.db
DATABASE_URL=sqlite:///./zoom.db

# LiveKit Cloud project (Settings -> Keys). The dummy values below let the server start
# and tests run, but real calls need real keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret

# Client origin(s), comma-separated, for CORS. The first one is used to build invite links.
CLIENT_ORIGIN=http://localhost:3000
